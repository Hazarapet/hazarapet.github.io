---
import affiliations from '../data/affiliations.yaml';

type Affil = { name: string; role?: string; dates?: string; logo: string };
const items = affiliations as Affil[];
---

<ul class="affils">
  {
    items.map((a) => (
      <li class="affil">
        <div class="affil__logo">
          <img src={a.logo} alt={a.name} loading="lazy" />
        </div>
        <div class="affil__name">{a.name}</div>
        {a.role && <div class="affil__role">{a.role}</div>}
        {a.dates && <div class="affil__dates">{a.dates}</div>}
      </li>
    ))
  }
</ul>

<style lang="scss">
  @use '../styles/variables' as *;

  .affils {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.75rem 1rem;
  }
  .affil {
    flex: 1 1 110px;
    max-width: 150px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .affil__logo {
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
  }
  .affil__logo img {
    max-height: 40px;
    max-width: 100%;
    width: auto;
    border-radius: $radius;
  }
  .affil__name {
    font-family: $font-body;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: $color-text;
    line-height: 1.3;
  }
  .affil__role {
    font-size: 13px;
    color: $color-text;
    margin-top: 2px;
  }
  .affil__dates {
    font-size: 12px;
    color: $color-muted;
    margin-top: 2px;
  }

  @media (max-width: 600px) {
    .affils {
      justify-content: center;
      gap: 1.5rem;
    }
    .affil {
      flex-basis: 40%;
    }
  }
</style>
