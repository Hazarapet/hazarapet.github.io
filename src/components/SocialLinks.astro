---
import profile from '../data/profile.yaml';

const s = profile.social ?? {};

const labels: Record<string, string> = {
  scholar: 'Scholar',
  github: 'GitHub',
  cv: 'CV',
  email: 'Email',
  linkedin: 'LinkedIn',
  twitter: 'Twitter',
};

// Inline monochrome brand SVGs (24x24, fill=currentColor) — self-hosted, no
// icon font or CDN. Recognizable marks (Simple Icons paths). They inherit the
// link color via currentColor.
const icons: Record<string, string> = {
  scholar:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.547 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>',
  github:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>',
  cv: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>',
  email:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"/></svg>',
  twitter:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932zM17.61 20.644h2.039L6.486 3.24H4.298z"/></svg>',
};

// Brand color per platform. Icon (currentColor) and label both use it.
const brand: Record<string, string> = {
  scholar: '#4285F4',
  github: '#181717',
  cv: '#475569',
  email: '#EA4335',
  linkedin: '#0A66C2',
  twitter: '#1DA1F2',
};

const links = Object.keys(s)
  .filter((key) => key !== 'primary' && s[key])
  .map((key) => ({
    key,
    label: labels[key] ?? key,
    href: key === 'email' ? `mailto:${s[key]}` : s[key],
    icon: icons[key],
    color: brand[key] ?? 'var(--social-default, currentColor)',
  }));
---

<p class="social">
  {
    links.map((l, i) => (
      <Fragment>
        {i > 0 && <span class="social__sep" aria-hidden="true">/</span>}
        <a
          class="social__link"
          href={l.href}
          rel="noopener"
          target="_blank"
          style={`color:${l.color}`}
        >
          <span class="social__icon" set:html={l.icon} />
          <span>{l.label}</span>
        </a>
      </Fragment>
    ))
  }
</p>

<style lang="scss">
  @use '../styles/variables' as *;

  .social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
  }
  .social__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: $color-primary;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }
  .social__link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .social__icon {
    display: inline-flex;
  }
  .social__icon :global(svg) {
    width: 0.95em;
    height: 0.95em;
    display: block;
  }
  .social__sep {
    color: $color-secondary;
    opacity: 0.45;
  }
</style>
