---
import talks from '../data/talks.yaml';

type Talk = { date: string; title: string; host?: string; hostUrl?: string };
const items = talks as Talk[];
---

<ul class="talks">
  {
    items.map((t) => (
      <li class="talks__item">
        <span class="talks__date">{t.date}</span>
        <span class="talks__body">
          <span class="talks__title">{t.title}</span>
          {t.host && (
            <span class="talks__host">
              {' — '}
              {t.hostUrl ? (
                <a href={t.hostUrl} rel="noopener" target="_blank">
                  {t.host}
                </a>
              ) : (
                t.host
              )}
            </span>
          )}
        </span>
      </li>
    ))
  }
</ul>

<style lang="scss">
  @use '../styles/variables' as *;

  .talks {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .talks__item {
    display: flex;
    gap: 0.75rem;
    padding: 0.35rem 0;
  }
  .talks__date {
    flex: 0 0 5.5rem;
    color: $color-muted;
    font-variant-numeric: tabular-nums;
  }
  .talks__host {
    color: $color-muted;
  }

  @media (max-width: 480px) {
    .talks__item {
      flex-direction: column;
      gap: 0.1rem;
    }
    .talks__date {
      flex-basis: auto;
      font-size: 0.85rem;
    }
  }
</style>
