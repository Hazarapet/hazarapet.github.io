---
import service from '../data/service.yaml';

type Service = { role: string; venues: string };
const items = service as Service[];
---

<ul class="service">
  {
    items.map((s) => (
      <li class="service__item">
        <span class="service__role">{s.role}:</span>
        <span class="service__venues">{s.venues}</span>
      </li>
    ))
  }
</ul>

<style lang="scss">
  @use '../styles/variables' as *;

  .service {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service__item {
    padding: 0.3rem 0;
  }
  .service__role {
    font-weight: 600;
    margin-right: 0.4rem;
  }
  .service__venues {
    color: $color-muted;
  }
</style>
