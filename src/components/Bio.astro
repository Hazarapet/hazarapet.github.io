---
import profile from '../data/profile.yaml';
import SocialLinks from './SocialLinks.astro';

const titleLine = [profile.title, profile.affiliation]
  .filter(Boolean)
  .join('  ·  ');
---

<section class="bio">
  <div class="bio__text">
    <h1 class="bio__name">{profile.name}</h1>
    {titleLine && <p class="bio__title">{titleLine}</p>}
    <p class="bio__summary" set:html={profile.bio} />

    {
      profile.interests?.length > 0 && (
        <p class="bio__interests">{profile.interests.join('  ·  ')}</p>
      )
    }

    <SocialLinks />
  </div>

  <div class="bio__photo">
    <img src={profile.photo} alt={profile.name} width="220" height="220"/>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;

  .bio {
    display: flex;
    gap: 2.25rem;
    align-items: flex-start;
  }
  .bio__photo {
    flex: 0 0 auto;
  }
  .bio__photo img {
    width: 220px;
    height: 220px;
    border-radius: $radius;
    object-fit: cover;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
  }
  .bio__text {
    flex: 1 1 auto;
    min-width: 0;
  }
  .bio__name {
    font-family: $font-heading;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -1.5px;
    color: $color-name;
    margin: 0 0 6px;
  }
  .bio__title {
    margin: 0 0 10px;
    color: $color-muted;
    font-size: 14px;
  }
  .bio__summary {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.7;
  }
  .bio__interests {
    margin: 1rem 0 0;
    color: $color-muted;
    font-size: 12.5px;
  }

  // Stack on small screens; photo on top, left-aligned.
  @media (max-width: 600px) {
    .bio {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .bio__name {
      font-size: 1.9rem;
    }
  }
</style>
