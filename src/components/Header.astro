---
import profile from '../data/profile.yaml';

// Normalize current path (strip trailing slash) for active-link matching.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const logo = profile.logo ?? profile.name;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/">{logo}</a>
    <nav class="site-nav" aria-label="Primary">
      {
        profile.nav.map((item: { label: string; href: string }) => {
          const target = item.href.replace(/\/+$/, '') || '/';
          return (
            <a
              class:list={['site-nav__link', { 'is-active': path === target }]}
              href={item.href}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<style lang="scss">
  @use '../styles/variables' as *;

  .site-header {
    border-bottom: 1px solid $color-border;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }
  .site-header__logo {
    font-family: $font-heading;
    font-weight: 700;
    font-size: 1.15rem;
    color: $color-heading;
    text-decoration: none;
  }
  .site-header__logo:hover {
    color: $color-heading;
    text-decoration: none;
  }
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
  }
  .site-nav__link {
    color: $color-secondary;
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .site-nav__link:hover {
    color: $color-text;
    text-decoration: none;
  }
  .site-nav__link.is-active {
    color: $color-text;
  }

  @media (max-width: 520px) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .site-nav {
      gap: 1.25rem;
    }
  }
</style>
